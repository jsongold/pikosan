# Copy to .env.local (gitignored). Never commit real keys or catalog exports.
# Set only one catalog source. If neither is set, `npm run build` fails on purpose.

# --- Local JSON (development) ---
# Directory produced by tools/export_site_data.py OUTSIDE this repo:
# CATALOG_DATA_DIR=/absolute/path/to/cafe-index-data
# Labelled fictional fixture for tests / CI only (not a real catalog):
# CATALOG_DATA_DIR=fixtures/demo

# --- Supabase (read-only at build time) ---
# Apply supabase/migrations, then set the project URL and a key.
# Prefer the anon key so RLS (public SELECT, no writes) applies.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# Server-only alternative. Bypasses RLS. Never use a NEXT_PUBLIC_ name.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_SECRET_KEY=your-secret-key

# Public site URL used for canonical, Open Graph, and sitemap.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Source SQLite catalog for tools/export_site_data.py only (not used by the site):
# CAFE_DB=/absolute/path/to/cafe.db
# CAFE_CONFIG_DIR=/absolute/path/to/config/domains/cafe
